{
  "name": "markdown-blog-editor",
  "productName": "Almost Editor",
  "version": "0.6.1",
  "description": "A simple macOS Markdown editor for blog posts with ImageMagick-powered image handling and tag insertion.",
  "main": "main.js",
  "scripts": {
    "build": "esbuild renderer/editor-source.js --bundle --format=esm --platform=browser --outfile=renderer/editor.bundle.js && node scripts/clean-editor-bundle.cjs",
    "test": "node --test",
    "start": "npm run build && electron .",
    "pack:mac": "npm run build && electron-builder --mac dir --arm64",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 && node scripts/remove-mac-staging.cjs"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "dompurify": "^3.4.15",
    "marked": "^12.0.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12"
  },
  "build": {
    "appId": "com.mendable.almosteditor",
    "productName": "Almost Editor",
    "compression": "maximum",
    "electronLanguages": [
      "en"
    ],
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/index.html",
      "renderer/style.css",
      "renderer/renderer.js",
      "renderer/editor.bundle.js",
      "renderer/*.mjs",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon-modern-bright.png",
      "target": [
        "dmg"
      ]
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
