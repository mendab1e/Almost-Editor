{
  "name": "markdown-blog-editor",
  "productName": "Almost Editor",
  "version": "0.1.0",
  "description": "A simple macOS Markdown editor for blog posts with ImageMagick-powered image handling and tag insertion.",
  "main": "main.js",
  "scripts": {
    "build": "esbuild renderer/editor-source.js --bundle --format=esm --platform=browser --outfile=renderer/editor.bundle.js",
    "start": "npm run build && electron ."
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.7",
    "marked": "^12.0.0"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "esbuild": "^0.25.12"
  }
}
